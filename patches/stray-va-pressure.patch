+/* Under virtual_mutex. Timestamp data is already collected by the original mapper.
+ * Only repeated full-search cost may open an exact-next-address trial. Cap each
+ * contribution so a single descheduling pause cannot enable it. */
+struct stray_va_pressure
+{
+    uintptr_t lo, hi;
+    uint64_t block_ns;
+    unsigned int samples, slow, failures, skip;
+};
+
+static int stray_va_pressure_result( struct stray_va_pressure *p, uintptr_t lo, uintptr_t hi,
+                                     uint64_t full_ns, int early, int hit )
+{
+    if (p->lo != lo || p->hi != hi)
+        *p = (struct stray_va_pressure){ .lo = lo, .hi = hi };
+    if (early)
+    {
+        if (hit) p->failures = p->skip = 0;
+        else
+        {
+            if (p->failures < 5) p->failures++;
+            p->skip = (2u << p->failures) - 1;
+        }
+    }
+    if (hit) return 0;
+    p->block_ns += full_ns < 128000 ? full_ns : 128000;
+    if (++p->samples == 64)
+    {
+        p->slow = p->block_ns >= 64 * 32000;
+        p->samples = p->block_ns = 0;
+    }
+    if (p->skip)
+    {
+        p->skip--;
+        return 0;
+    }
+    return p->slow;
+}
